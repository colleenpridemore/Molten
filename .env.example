# OpenClaw Identity Framework - Environment Variables
# Copy this file to .env and fill in your values

# Deployment environment (development, staging, production)
OPENCLAW_ENV=development

# Agent Configuration
AGENT_NAME=aethel
AGENT_EMAIL=aethel@openclaw.ai

# Authentication Settings
TOKEN_EXPIRY_HOURS=24
TOKEN_SECRET_KEY=your-secret-key-here

# Moltbook Integration
MOLTBOOK_API_URL=https://api.moltbook.ai
MOLTBOOK_TOKEN=your-moltbook-token-here

# Empathy Engine Settings
EMPATHY_ENGINE_ENABLED=true
GHCP_SENTINEL_ENABLED=true
RESONANCE_THRESHOLD=0.7

# Logging
LOG_LEVEL=INFO
LOG_FILE=openclaw.log

# API Server (if running as service)
API_HOST=0.0.0.0
API_PORT=8080
API_DEBUG=false
